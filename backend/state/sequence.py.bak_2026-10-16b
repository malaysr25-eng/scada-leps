STEP_BY_KEY = {s.key: s for s in STEPS}

# Steps whose guard we can actually watch, in order. Inference walks these.
OBSERVABLE_STEPS = [s for s in STEPS if s.guard_kind in (GUARD_SENSOR, GUARD_OPERATOR)]


@dataclass
class SequenceState:
    """Live position in the sequence, plus why we believe it."""

    step_index: int = 0
    confidence: str = "none"     # none | low | inferred
    entered_at: float = field(default_factory=time.time)
    waiting_for: Optional[str] = None
    waiting_role: Optional[str] = None
    waiting_since: Optional[float] = None
    last_confirmed_step: Optional[int] = None
    last_confirmed_at: Optional[float] = None
    timeout_s: float = 30.0
    stalled: bool = False
    awaiting_operator: bool = False
    history: List[dict] = field(default_factory=list)

    def to_dict(self, running: bool) -> dict:
        step = STEPS[self.step_index] if 0 <= self.step_index < len(STEPS) else None
        elapsed = time.time() - (self.waiting_since or self.entered_at)
        return {
            "stepIndex": self.step_index,
            "step": step.to_dict() if step else None,
            "confidence": self.confidence,
            "inferred": True,
            "enteredAt": self.entered_at,
            "elapsedSeconds": round(elapsed, 2),
            "waitingFor": self.waiting_for,
            "waitingRole": self.waiting_role,
            "waitingSince": self.waiting_since,
            "timeoutSeconds": self.timeout_s,
            "stalled": self.stalled and running,
            "awaitingOperator": self.awaiting_operator and running,
            "lastConfirmedStep": self.last_confirmed_step,
            "lastConfirmedAt": self.last_confirmed_at,
            "history": self.history[-30:],
        }


class SequenceTracker:
    """
    Infers the active step from observable guards.

    ORDERED, COUNTED RISING EDGES
    -----------------------------
    Guards are matched strictly in sequence order, one at a time. Edge guards
    are matched against *counted transitions* reported by the poller, not
    against the current level.

    All three properties are load-bearing:

    * *Ordered* -- a real sequencer visits its states in order. Scanning every
      guard at once and taking the furthest match lets an unrelated signal
      teleport the timeline forward.

    * *Edges, not levels* -- several guards are steady-state TRUE at rest. The
      plate low-limit switch is closed whenever the plate is parked down, its
      normal condition. A level test would satisfy S28_HEIGHT_BOTTOM on the
      first poll of every cycle and report the machine as nearly finished
      before it had moved.

    * *Counted, not sampled* -- at 250 ms polling, PX1 rising and conveyor 1
      starting frequently land in the *same* poll. Sampling the level when the
      cursor arrives would see the belt already running, conclude it had always
      been high, and then wait forever for an edge that had already happened.
      Rises are counted wherever the cursor happens to be, and the cursor
      consumes them in order, so nothing is missed and nothing is
      double-counted.

    Level guards (preconditions such as air pressure healthy) are matched
    against the current value instead -- demanding an edge from a precondition
    would mean waiting for a healthy signal to fail first.

    Unobservable guards are passed through without confirmation; confidence
    never rises above "inferred", because it is an inference.
    """

    def __init__(self, event_log, step_timeout: float = 30.0) -> None:
        self.events = event_log
        self.default_timeout = step_timeout
        self.state = SequenceState(timeout_s=step_timeout)
        self._satisfied: Dict[str, float] = {}
        self._cursor = 0                      # index into OBSERVABLE_STEPS
        self._rises: Dict[str, int] = {}      # role -> rises seen this cycle
        self._consumed: Dict[str, int] = {}   # role -> rises already matched
        self._stall_announced = False

    def reset(self, reason: str = "cycle reset") -> None:
        self.state = SequenceState(timeout_s=self.default_timeout)
        self._satisfied.clear()
        self._cursor = 0
        self._rises.clear()
        self._consumed.clear()
        self._stall_announced = False
        self.events.info("sequence", "Sequence tracker reset (%s)" % reason)

    def observe(self, role_changes: List[dict]) -> None:
        """
        Count rising edges from the poller's change list.

        Called every poll regardless of cursor position, so an edge occurring
        while an earlier guard is still being confirmed is not lost.
        """
        for change in role_changes:
            role = change.get("role")
            if role and change.get("previous") is not True and change.get("value") is True:
                self._rises[role] = self._rises.get(role, 0) + 1

    def _is_satisfied(self, step: Step, roles: Dict[str, Any]) -> bool:
        role = step.guard_role
        if not role:
            return False
        if not step.edge:
            return roles.get(role) is True
        return self._rises.get(role, 0) > self._consumed.get(role, 0)

    def update(self, roles: Dict[str, Any], running: bool) -> SequenceState:
        now = time.time()

        if not running:
            self.state.stalled = False
            self.state.waiting_for = None
            self.state.waiting_role = None
            # The PLC raises Cycle_Completed in the same scan it drops CMD_START, so the poll that
            # carries the completion is already "not running". Without this the timeline stayed
            # parked (spinning) on the step before the outfeed until the next start (2026-10-16).
            last = STEPS[-1]
            if (
                self.state.last_confirmed_step is not None
                and self.state.last_confirmed_step < last.index
                and (roles.get(last.guard_role) is True
                     or self._rises.get(last.guard_role, 0) > self._consumed.get(last.guard_role, 0))
            ):
                self._consumed[last.guard_role] = self._rises.get(last.guard_role, 0)
                self._cursor = len(OBSERVABLE_STEPS)
                self._satisfied[last.key] = now
                self.state.history.append({
                    "stepIndex": last.index, "name": last.name, "at": now, "guard": last.guard_label,
                })
                self.events.plc(
                    "sequence", "Step %d confirmed: %s (%s)" % (last.index, last.name, last.guard_label),
                    stepIndex=last.index, guardRole=last.guard_role,
                )
                self.state.last_confirmed_step = last.index
                self.state.last_confirmed_at = now
                self.state.step_index = last.index
                self.state.entered_at = now
                self.state.waiting_since = None
                self.state.awaiting_operator = False
            return self.state

        # Advance the cursor across every guard already satisfied. A loop, not
        # an `if`, so a burst of fast transitions between two polls does not
        # leave the timeline lagging behind the machine.
        while self._cursor < len(OBSERVABLE_STEPS):
            step = OBSERVABLE_STEPS[self._cursor]
            if not self._is_satisfied(step, roles):
                break

            if step.edge and step.guard_role:
                self._consumed[step.guard_role] = (
                    self._consumed.get(step.guard_role, 0) + 1
                )

            self._satisfied[step.key] = now
            self.state.history.append({
                "stepIndex": step.index,
                "name": step.name,
                "at": now,
                "guard": step.guard_label,
            })
            self.events.plc(
                "sequence",
                "Step %d confirmed: %s (%s)" % (step.index, step.name, step.guard_label),
                stepIndex=step.index, guardRole=step.guard_role,
            )
            self.state.last_confirmed_step = step.index
            self.state.last_confirmed_at = now

            # A stall that resolves must not leave a latched fault behind,
            # otherwise the machine sits in FAULT for the rest of the cycle.
            if self._stall_announced:
                self.events.clear_fault(
                    "sequence.stalled.%s" % step.key,
                    "Sequence resumed: %s confirmed." % step.guard_label,
                )
                self._stall_announced = False

            self._cursor += 1

        # Active step: the one after the last confirmation.
        if self.state.last_confirmed_step is not None:
            active_index = min(self.state.last_confirmed_step + 1, len(STEPS) - 1)
            self.state.confidence = "inferred"
        else:
            active_index = 1  # camera detect, the first real step
            self.state.confidence = "low"

        if active_index != self.state.step_index:
            self.state.step_index = active_index
            self.state.entered_at = now
            self.state.waiting_since = now
            self._stall_announced = False
            self.state.stalled = False

        # What are we waiting for? Whatever the cursor is parked on.
        pending = (
            OBSERVABLE_STEPS[self._cursor]
            if self._cursor < len(OBSERVABLE_STEPS) else None
        )
        if pending:
            self.state.waiting_for = pending.guard_label
            self.state.waiting_role = pending.guard_role
            if self.state.waiting_since is None:
                self.state.waiting_since = now

            elapsed = now - (self.state.waiting_since or now)

            # `typical_seconds` is the twin's NOMINAL DURATION for a step, not
            # a timeout budget. Using it as one made the engraving step raise a
            # fault 1.5 s after the machine started waiting for a human -- the
            # 1.5 s being the model's placeholder estimate of how long an
            # operator takes to press a button, which the twin's own docs flag
            # as unmeasured. A person is not late at 1.5 s.
            #
            # So: waiting on an operator is never a stall. The UI shows
            # "awaiting operator" prominently instead, which is the truthful
            # thing to display. Machine steps keep the configured budget.
            timeout = (
                None if pending.guard_kind == GUARD_OPERATOR
                else self.default_timeout
            )
            self.state.timeout_s = timeout or 0.0
            self.state.awaiting_operator = pending.guard_kind == GUARD_OPERATOR

            if timeout is not None and elapsed > timeout:
                self.state.stalled = True
                if not self._stall_announced:
                    self._stall_announced = True
                    self.events.raise_fault(
                        "sequence.stalled.%s" % pending.key,
                        "Sequence stalled at step %d (%s): waiting %.1f s for %s"
                        % (pending.index, pending.name, elapsed, pending.guard_label),
                        stepIndex=pending.index, guardRole=pending.guard_role,
                    )
            else:
                self.state.stalled = False
        else:
            self.state.waiting_for = None
            self.state.waiting_role = None
            self.state.stalled = False
            self.state.awaiting_operator = False

        return self.state

def sequence_catalogue() -> List[dict]:
    return [s.to_dict() for s in STEPS]

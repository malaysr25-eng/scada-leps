"""
The 42-step process sequence, and live inference of where the machine is in it.

SOURCES
-------
* ``Industry 4.0_5.0 Lab data.xlsx`` sheet ``Sequencing`` -- the 42 process rows.
* ``Factory_Simulation/factory_states.m`` -- the digital twin's 40-state table,
  which already maps each state to its Excel row and names the sensor guard
  that must go TRUE to advance. That mapping is reused verbatim rather than
  re-derived, so the HMI timeline and the twin cannot drift apart.

AN HONEST LIMITATION, STATED UP FRONT
-------------------------------------
The PLC does **not** publish a step index. There is no such tag anywhere in
``Tag_list (1).xlsx``. The active step shown by this module is therefore
**INFERRED** from the observable sensor/output pattern, never read. Every step
carries ``confidence``, and the UI labels the timeline as inferred.

Guards that map onto a real, documented PLC tag are marked ``observable``.
Guards that do not -- per-cylinder reed switches (EXT/RET) have no tag in the
list, and the camera guard lives outside the PLC -- are marked
``unobservable`` and can never be used to claim confirmation. This is why the
timeline shows "waiting for PX3" precisely, but says "cannot confirm cylinder
retract: no reed-switch tag exists" instead of inventing one.
"""

from __future__ import annotations

import time
from dataclasses import dataclass, field
from typing import Any, Dict, List, Optional

# Guard kinds.
GUARD_SENSOR = "sensor"        # a documented PLC input we can watch
GUARD_IMMEDIATE = "immediate"   # no wait; the PLC falls straight through
GUARD_TIMER = "timer"           # operator action, no duration in any source
GUARD_OPERATOR = "operator"     # waits on an explicit operator acknowledgement
GUARD_UNOBSERVABLE = "unobservable"  # real guard, but no tag exists for it
GUARD_EXTERNAL = "external"     # outside the PLC (camera)

# Guard semantics.
#
# EDGE  -- the guard describes an *event*: a part arriving at a sensor, a belt
#          starting, the operator pressing acknowledge. Several of these tags
#          are steady-state TRUE at rest (the plate low-limit switch is closed
#          whenever the plate is parked down), so they are matched on a rising
#          edge only.
# LEVEL -- the guard describes a *precondition* that is simply required to be
#          true, such as air pressure being healthy. Demanding an edge from a
#          precondition would wait forever for a healthy signal to fail.
EDGE = True
LEVEL = False


@dataclass
class Step:
    index: int
    key: str
    name: str
    excel_ref: str
    station: str
    guard_kind: str
    guard_label: str
    guard_role: Optional[str] = None
    guard_expect: Any = True
    twin_state: Optional[str] = None
    implicit: bool = False
    anomaly: str = ""
    typical_seconds: Optional[float] = None
    edge: bool = EDGE

    def to_dict(self) -> dict:
        return {
            "index": self.index,
            "key": self.key,
            "name": self.name,
            "excelRef": self.excel_ref,
            "station": self.station,
            "guardKind": self.guard_kind,
            "guardLabel": self.guard_label,
            "guardRole": self.guard_role,
            "guardExpect": self.guard_expect,
            "twinState": self.twin_state,
            "implicit": self.implicit,
            "anomaly": self.anomaly,
            "observable": self.guard_kind in (GUARD_SENSOR, GUARD_OPERATOR),
            "typicalSeconds": self.typical_seconds,
            "guardSemantics": "edge" if self.edge else "level",
        }


def _s(index, key, name, excel_ref, station, kind, label, role=None,
       twin=None, implicit=False, anomaly="", typical=None, edge=EDGE) -> Step:
    return Step(index, key, name, excel_ref, station, kind, label, role,
                True, twin, implicit, anomaly, typical, edge)


